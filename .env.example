# Optional stock news credentials
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Optional CryptoPanic credential
CRYPTOPANIC_API_KEY=

# Required only for Reddit ingestion; create a free script app at reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sentrune-data-layer/0.1
# Conservative pacing: one second between Reddit listing requests (~60 requests/minute max)
REDDIT_DELAY_SECONDS=1.0
# Safety caps per ingestion run
REDDIT_MAX_SUBREDDITS=10
REDDIT_MAX_USERNAMES=20

# Optional local database override. The default (../data/trading_assistant.sqlite3,
# relative to data-layer/) converges with the feature-engineering and model layers;
# only override it if you intentionally want to split databases.
# DB_PATH=../data/trading_assistant.sqlite3
# Render live mode: mount a persistent disk at /var/data and set:
# DB_PATH=/var/data/trading_assistant.sqlite3
# SENTRUNE_MODEL_DIR=/var/data/models
PRICE_INTERVAL=1d
# Comma-separated intervals fetched by the automatic refresh, for example:
# PRICE_INTERVALS=1d,1h,1wk
# Dashboard refresh/ingestion cadence while the page is open:
# AUTO_REFRESH_MINUTES=15
